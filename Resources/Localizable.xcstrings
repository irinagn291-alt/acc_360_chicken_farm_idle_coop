    "Gather 10 grain for free every 30 minutes. A small harvest keeps your farm going, even with no coins.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gather 10 grain for free every 30 minutes. A small harvest keeps your farm going, even with no coins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle alle 30 Minuten kostenlos 10 Korn. Eine kleine Ernte hält deinen Hof auch ohne Münzen am Laufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramassez gratuitement 10 grains toutes les 30 minutes. Cette petite récolte fait vivre votre ferme, même sans pièces."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recolha 10 grãos grátis a cada 30 minutos. Uma pequena colheita mantém sua fazenda ativa, mesmo sem moedas."
          }
        }
      }
    },
