    "Each hen uses 1 grain every 10 minutes. Eggs grow only while the trough has grain. A full nest pauses egg storage; feeding still continues.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each hen uses 1 grain every 10 minutes. Eggs grow only while the trough has grain. A full nest pauses egg storage; feeding still continues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Huhn braucht alle 10 Minuten 1 Korn. Eier entstehen nur mit Korn im Trog. Bei vollem Nest stoppt die Eiersammlung; Futter wird weiter verbraucht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque poule consomme 1 grain toutes les 10 minutes. La production nécessite des grains dans la mangeoire. Un nid plein arrête le stockage des œufs ; les poules continuent de manger."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada galinha usa 1 grão a cada 10 minutos. Os ovos são produzidos enquanto há grãos no comedouro. Um ninho cheio pausa o acúmulo de ovos; o consumo de alimento continua."
          }
        }
      }
    },
